decl {
    #include <time.h>

    #define PROGR_TIMEOUT       (10000)     // stay in PROGRAM mode for at most 10 sec if no cmds arrive
}

export {
    typedef enum {
        AlarmCmd_NoCommand,
        AlarmCmd_ProgrSet,
        AlarmCmd_ProgrPlus,
        AlarmCmd_ProgrMinus
    } alarm_cmd_t;

    typedef struct {
        unsigned int hour;
        unsigned int minute;
    } alarm_time_t;
}

time {
    struct timespec t;
    clock_gettime(CLOCK_MONOTONIC, &t);
    return t;
}

fsm alarm 
{
    input alarm_cmd_t cmd = AlarmCmd_NoCommand;
    var alarm_time_t cur_set_time = {0};
    output alarm_time_t alarm_time = {0};
    timer programming_timeout(PROGR_TIMEOUT);

    state [reset] PROGRAMMED
    on (cmd == AlarmCmd_ProgrSet) go SET_HOUR
    out alarm_time = { return this->cur_set_time; } ;

    state SET_HOUR {
        if (this->cmd == AlarmCmd_ProgrPlus) {
            this->cur_set_time.hour = this->cur_set_time.hour == 23 ? 0 : (this->cur_set_time.hour+1);
            fsm_timer_start(&this->programming_timeout);
        }
        else if (this->cmd == AlarmCmd_ProgrMinus) {
            this->cur_set_time.hour = this->cur_set_time.hour == 0 ? 23 : (this->cur_set_time.hour-1);
            fsm_timer_start(&this->programming_timeout);
        } 
    }
    on (cmd == AlarmCmd_ProgrSet) go SET_MINUTE start programming_timeout
    on timeout(programming_timeout) go PROGRAMMED
    out alarm_time = { return this->cur_set_time; } ;

    state SET_MINUTE {
        if (this->cmd == AlarmCmd_ProgrPlus) {
            this->cur_set_time.minute = this->cur_set_time.minute == 59 ? 0 : (this->cur_set_time.minute+1);
            fsm_timer_start(&this->programming_timeout);
        }
        else if (this->cmd == AlarmCmd_ProgrMinus) {
            this->cur_set_time.minute = this->cur_set_time.minute == 0 ? 59 : (this->cur_set_time.minute-1);
            fsm_timer_start(&this->programming_timeout);
        } 
    }
    on (cmd == AlarmCmd_ProgrSet) go PROGRAMMED
    on timeout(programming_timeout) go PROGRAMMED
    out alarm_time = { return this->cur_set_time; } ;
}